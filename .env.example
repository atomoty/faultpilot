# FaultPilot AI provider: mock | openai-api | codex-cli
# - openai-api: set OPENAI_* below.
# - codex-cli (experimental, local-only): run `codex login` yourself first; no keys needed here.
#   Never use codex-cli for online deployments.
FAULTPILOT_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com

# Example read-only local database credentials
FAULTPILOT_DB_URL=
FAULTPILOT_DB_USERNAME=
FAULTPILOT_DB_PASSWORD=
